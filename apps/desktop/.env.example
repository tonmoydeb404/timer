# Read by Vite at dev/build time (import.meta.env). The Appwrite values
# are public by design; this file is the single source for local dev.
VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
# Base URL of the web app — desktop OAuth lands on its /auth/desktop
# bridge, which forwards to the tymar:// scheme. Dev default is the web
# dev server; production desktop builds must bake the deployed web URL.
VITE_WEB_URL=http://localhost:3010
