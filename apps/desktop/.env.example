# Read by Vite at dev/build time (import.meta.env). The frontend pushes
# these to the Rust backend at boot, so no shell exports are needed —
# this file is the single source of config for local dev.
VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
# Base URL of the web app — used as the OAuth success/failure target.
VITE_WEB_URL=http://localhost:3010
