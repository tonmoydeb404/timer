# Read by Vite at dev/build time (import.meta.env). Rust also needs these
# as real environment variables at compile time (option_env!):
#   export APPWRITE_ENDPOINT APPWRITE_PROJECT_ID
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
# Base URL of the web app — used as the OAuth success/failure target.
VITE_WEB_URL=http://localhost:3010
