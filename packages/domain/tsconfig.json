{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@packages/typescript-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": {
      "@packages/domain/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
